# Site
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database
DATABASE_URL=

# ImageKit
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_ENABLED=

# Analytics (GTM primary, GA4 direct fallback — only one mode runs at a time)
# mode: "gtm" | "ga" | "off"
# Also requires NEXT_PUBLIC_VERCEL_ENV=production (Vercel sets this automatically
# on production deploys, never locally) — ANALYTICS_ENABLED alone is not enough.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_MODE=gtm
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
